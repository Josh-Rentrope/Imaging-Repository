{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boneviewer.local/schemas/results.schema.json",
  "title": "ResultEnvelope",
  "description": "Everything the pipeline returns. Every result carries the exact model_version that produced it -- non-negotiable in a medical context, and impossible to backfill.",
  "type": "object",
  "required": [
    "schema_version",
    "result_id",
    "source_capture_id",
    "ops",
    "model_version",
    "scale",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "result_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_capture_id": {
      "type": "string",
      "format": "uuid"
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Operations that ran, in order. An open vocabulary: backends may implement names beyond the canonical set (rectify, reconstruct, segment, measure, isolate_volume, iso_surface, detect_caries).",
      "examples": [
        [
          "rectify",
          "reconstruct",
          "segment",
          "measure"
        ]
      ]
    },
    "model_version": {
      "type": "string",
      "description": "Opaque registry key identifying the weights that produced this result.",
      "examples": [
        "tsdf@0.1.0",
        "toothseg@2026-10-04+a3f1"
      ]
    },
    "rectification": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "frames_in": {
          "type": "integer"
        },
        "frames_kept": {
          "type": "integer"
        },
        "depth_frames": {
          "type": "integer"
        },
        "depth_aligned": {
          "type": "boolean"
        },
        "extrinsics_source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "measured",
            "assumed",
            "calibrated",
            null
          ]
        }
      }
    },
    "geometry": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "bounds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6,
          "description": "[xmin, xmax, ymin, ymax, zmin, zmax] of the extracted surface, world space."
        },
        "frames": {
          "type": "integer",
          "minimum": 0,
          "description": "Frames the pose stage was given."
        },
        "frames_used": {
          "type": "integer"
        },
        "mask_dims": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "Voxel dimensions of the segmentation mask, which is its own grid: a segmenter resamples, so it does not match the source volume's dims."
        },
        "mask_placement": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "description": "Where a segmentation landed relative to the volume it was computed on. Both cover the same field of view, so a low overlap means one of them is misplaced \u2014 which is invisible from the mask's own numbers, since from the mask's point of view its geometry is correct.",
          "properties": {
            "mask_bounds": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 6,
              "maxItems": 6,
              "description": "[xmin, xmax, ymin, ymax, zmin, zmax] in world space, as geometry.bounds."
            },
            "volume_bounds": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 6,
              "maxItems": 6
            },
            "overlap_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Share of the mask's box that lands inside the volume's."
            },
            "centre_offset_mm": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "agrees": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "mask_spacing": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "Voxel size of the mask in millimetres, in mask axis order."
        },
        "pose_solver": {
          "type": "string",
          "description": "Which framework produced the trajectory, when one did. Absent when the device supplied poses. See GET /solvers for the known names."
        },
        "pose_source": {
          "type": "string",
          "enum": [
            "device",
            "sfm",
            "placeholder"
          ],
          "description": "Where the camera trajectory came from. `placeholder` means no solver ran and the geometry is not a trajectory."
        },
        "poses_solved": {
          "type": "integer",
          "minimum": 0,
          "description": "Poses solved here. Zero when the capture brought its own, or when nothing solved them."
        },
        "registration_residual_mm": {
          "type": "number"
        },
        "reprojection_residual_px": {
          "type": "number",
          "minimum": 0,
          "description": "Mean reprojection error the solver reported, in pixels. Absent when the solver does not report one."
        },
        "scale_known": {
          "type": "boolean",
          "description": "Whether the trajectory is metric. A solved one never is, which is why this is separate from scale.verified."
        },
        "simplify_mm": {
          "type": "number",
          "description": "Clustering cell size the surface was simplified at, in millimetres. Absent when it was not simplified. Absolute rather than a multiple of the voxel size, so the same setting means the same thing on a 0.7 mm mask and a 2.5 mm volume."
        },
        "stride": {
          "type": "integer",
          "minimum": 1,
          "description": "Voxel subsampling applied before extraction."
        },
        "threshold": {
          "type": "number",
          "description": "Density threshold the surface was extracted at, in the volume's units."
        },
        "triangles_before": {
          "type": "integer",
          "minimum": 0
        },
        "vertices_before": {
          "type": "integer",
          "minimum": 0,
          "description": "Vertices before simplifying, so the reduction is a stated fact rather than an assumption."
        },
        "voxel_size_mm": {
          "type": "number"
        }
      }
    },
    "scale": {
      "type": "object",
      "required": [
        "verified"
      ],
      "additionalProperties": false,
      "properties": {
        "verified": {
          "type": "boolean",
          "description": "When false, all measurements are in arbitrary units and the UI MUST disable measurement affordances. See Notes/04."
        },
        "source": {
          "type": "string",
          "enum": [
            "depth_sensor",
            "fiducial",
            "prior_scan",
            "unknown"
          ]
        },
        "scale_error_pct": {
          "type": "number"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "format",
          "ref"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "mesh",
              "volume",
              "splat",
              "radiograph_overlay",
              "thumbnail",
              "report",
              "labels",
              "mask"
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "stl",
              "ply",
              "obj",
              "vtk",
              "vti",
              "nii",
              "png",
              "json",
              "pdf",
              "bin"
            ]
          },
          "ref": {
            "type": "string",
            "description": "Opaque storage reference."
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "units": {
            "type": "string",
            "enum": [
              "mm",
              "arbitrary"
            ]
          },
          "vertices": {
            "type": "integer",
            "minimum": 0
          },
          "triangles": {
            "type": "integer",
            "minimum": 0
          },
          "header_ref": {
            "type": "string",
            "description": "Companion header for a binary artifact -- a label legend, a mask geometry, and so on."
          }
        }
      }
    },
    "segmentation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "arch": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "both"
          ]
        },
        "unassigned_region_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "The honest denominator. Surface the UI, don't bury it. See Notes/05."
        },
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "instance_id"
            ],
            "additionalProperties": false,
            "properties": {
              "instance_id": {
                "type": "integer"
              },
              "fdi": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 11,
                "maximum": 48,
                "description": "ISO 3950. NULLABLE ON PURPOSE: an abstention is a usable output, a confident wrong label is a liability."
              },
              "fdi_confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1,
                "description": "Null when no number was assigned, which is an abstention rather than a low-confidence guess. Same treatment as crown_area_mm2."
              },
              "centroid": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "crown_area_mm2": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "crowding",
              "restored",
              "missing_units",
              "appliance_present",
              "partial_edentulism"
            ]
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "volumetric",
            "fdi"
          ],
          "description": "volumetric = a multi-label mask over a volume (CT). fdi = per-tooth instances on a surface."
        },
        "classes": {
          "type": "array",
          "description": "Volumetric path: one entry per label in the mask.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "volume": {
                "type": "number",
                "description": "Volume in mm^3, when the segmenter reports it."
              }
            }
          }
        },
        "mask_ref": {
          "type": "string",
          "description": "int32 multi-label mask blob, (nz, ny, nx) C-order."
        },
        "mask_header_ref": {
          "type": "string",
          "description": "JSON header for the mask: dims, spacing, origin, legend."
        }
      }
    },
    "measurements": {
      "type": "array",
      "description": "Empty whenever scale.verified is false.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "unit"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "examples": [
              "arch_width_molar_mm",
              "overjet_mm",
              "bone_loss_pct"
            ]
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "enum": [
              "mm",
              "um",
              "pct",
              "deg"
            ]
          },
          "uncertainty": {
            "type": "number",
            "description": "Report the uncertainty, not just the value."
          },
          "method": {
            "type": "string"
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverage_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100,
          "description": "Share of the intended capture volume the frames covered. Null when coverage was not measured, which is not the same as zero."
        },
        "gate_passed": {
          "type": "boolean"
        },
        "rejections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "insufficient_coverage",
                  "excessive_specular",
                  "motion_blur",
                  "underexposed",
                  "invalid_depth",
                  "scale_unresolved"
                ]
              },
              "detail": {
                "type": "string"
              },
              "frame_ids": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "server",
            "ondevice",
            "fixture"
          ]
        },
        "tenant_ref": {
          "type": "string"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "stages": {
          "type": "array",
          "description": "One entry per stage that was asked to run, in order, recorded before it ran so a failure is still accounted for. This is what makes an exported mesh traceable back to the tool that produced it.",
          "items": {
            "type": "object",
            "required": [
              "op"
            ],
            "additionalProperties": true,
            "properties": {
              "op": {
                "type": "string"
              },
              "params": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "tool": {
                "type": "string",
                "description": "The named software that ran, or a dash when it is part of the private backend."
              },
              "algorithm": {
                "type": "string",
                "description": "The general approach, not the implementation."
              },
              "notes": {
                "type": "string"
              },
              "duration_ms": {
                "type": "integer"
              }
            }
          }
        },
        "duration_ms": {
          "type": "integer"
        }
      }
    }
  }
}

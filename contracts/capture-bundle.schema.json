{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boneviewer.local/schemas/capture-bundle.schema.json",
  "title": "CaptureBundle",
  "description": "The seam between a capture client and the server. Clients send PRE-PROCESSED images, never raw frames. See Notes/02-system-architecture.md. Breaking changes require a schema_version bump.",
  "type": "object",
  "required": ["schema_version", "capture_id", "modality", "device", "frames", "quality"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Bumped on any breaking change. Servers must reject unknown majors."
    },
    "capture_id": { "type": "string", "format": "uuid" },
    "patient_ref": {
      "type": "string",
      "description": "Tenant-scoped pseudonymous reference. NEVER a name, MRN, or date of birth."
    },
    "modality": {
      "type": "string",
      "enum": ["rgbd", "rgb", "radiograph"]
    },
    "device": {
      "type": "object",
      "required": ["platform"],
      "additionalProperties": false,
      "properties": {
        "platform": { "type": "string", "enum": ["ios", "android", "browser"] },
        "model": { "type": "string", "examples": ["iPhone15,3", "SM-S918B"] },
        "depth_sensor": {
          "type": "string",
          "enum": ["truedepth", "lidar", "arcore_tof", "none"],
          "description": "'none' forces the RGB-only path and its scale caveats."
        },
        "depth_source": {
          "type": "string",
          "enum": ["arkit", "arcore_raw_depth", "arcore_automatic", "none"]
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "image_ref", "intrinsics"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "image_ref": {
            "type": "string",
            "description": "Opaque storage reference, resolved server-side. Uploaded separately via the ingest API."
          },
          "intrinsics": {
            "type": "object",
            "required": ["fx", "fy", "cx", "cy"],
            "additionalProperties": false,
            "properties": {
              "fx": { "type": "number" },
              "fy": { "type": "number" },
              "cx": { "type": "number" },
              "cy": { "type": "number" }
            }
          },
          "distortion": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model": { "type": "string", "enum": ["none", "brown", "fisheye"] },
              "k1": { "type": "number" },
              "k2": { "type": "number" },
              "p1": { "type": "number" },
              "p2": { "type": "number" }
            }
          },
          "pose": {
            "type": "array",
            "description": "Row-major 4x4 world-from-camera transform. Optional: pose-free pipelines estimate it server-side.",
            "items": { "type": "number" },
            "minItems": 16,
            "maxItems": 16
          },
          "timestamp_ns": { "type": "integer" }
        }
      }
    },
    "depth": {
      "type": "array",
      "description": "Required when modality=rgbd, forbidden otherwise.",
      "items": {
        "type": "object",
        "required": ["frame_id", "depth_ref"],
        "additionalProperties": false,
        "properties": {
          "frame_id": { "type": "integer", "minimum": 0 },
          "depth_ref": { "type": "string" },
          "scale_factor": {
            "type": "number",
            "description": "Multiply stored integers by this to get metres. 1.0 for float arrays."
          },
          "confidence_ref": { "type": "string" },
          "aligned_to_rgb": { "type": "boolean" }
        }
      }
    },
    "extrinsics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "depth_to_rgb": {
          "type": ["array", "null"],
          "description": "Row-major 4x4. null means ASSUME identity. This is the only honest value on iOS TrueDepth, where the platform does not expose this transform (Notes/04, source R5) and a per-generation factory calibration must be assumed correct.",
          "items": { "type": "number" },
          "minItems": 16,
          "maxItems": 16
        }
      }
    },
    "quality": {
      "type": "object",
      "required": ["coverage_pct"],
      "additionalProperties": false,
      "properties": {
        "per_frame": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "frame_id": { "type": "integer" },
              "blur": { "type": "number", "description": "Variance of Laplacian; higher is sharper." },
              "specular_pct": { "type": "number", "minimum": 0, "maximum": 100 },
              "exposure_clipped_pct": { "type": "number", "minimum": 0, "maximum": 100 },
              "depth_valid_pct": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        },
        "coverage_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "motion_index": { "type": "number" },
        "scale_reference": {
          "type": ["object", "null"],
          "description": "REQUIRED for modality=rgb. Without a scale anchor an RGB-only reconstruction has arbitrary units and the measurement UI must be disabled.",
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "enum": ["aruco", "apriltag", "known_object"] },
            "size_mm": { "type": "number", "exclusiveMinimum": 0 },
            "detected_frames": { "type": "array", "items": { "type": "integer" } },
            "residual_mm": { "type": "number" }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "captured_at": { "type": "string", "format": "date-time" },
        "app_version": { "type": "string" },
        "operator_ref": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "modality": { "const": "rgbd" } }, "required": ["modality"] },
      "then": { "required": ["depth"], "properties": { "depth": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "modality": { "const": "rgb" } }, "required": ["modality"] },
      "then": {
        "properties": {
          "quality": {
            "required": ["scale_reference"],
            "properties": { "scale_reference": { "type": "object" } }
          }
        }
      }
    }
  ]
}
